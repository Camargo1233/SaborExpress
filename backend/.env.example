# ---------------------------------------------------------------------
# Copie para .env e ajuste. O arquivo .env NUNCA vai para o Git.
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Banco de dados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sabor_express
DB_USER=sabor_app
DB_PASSWORD=troque-esta-senha
DB_SSL=false

# Autenticacao
# Gere um valor forte com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres
JWT_EXPIRES_IN=8h

# Origens liberadas no CORS (separadas por virgula). * apenas em desenvolvimento.
CORS_ORIGINS=http://localhost:8080,http://localhost:5000
